<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <!-- 1. HEADER (FIXED DI ATAS) -->
    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="15dp"
        android:paddingBottom="5dp"
        android:background="@color/bg_cream"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="50dp"
                android:layout_marginStart="-10dp">
                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="45dp"
                    android:src="@drawable/logo"
                    android:scaleType="centerCrop"
                    android:layout_gravity="left" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grafik Pengeluaran"
                android:textStyle="bold"
                android:textColor="@color/text_orange"
                android:textSize="17sp"
                android:layout_marginTop="-5dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_popup_reminder"
                app:tint="#FDD835"
                android:layout_marginEnd="15dp"/>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/text_grey"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. SCROLL CONTENT (ISI TENGAH) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/header_layout"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="15dp"
            android:paddingBottom="30dp">

            <!-- FILTER BULAN & TAHUN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bulan : "
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginEnd="5dp"/>

                <Spinner
                    android:layout_width="98dp"
                    android:layout_height="25dp"
                    android:id="@+id/spinner_bulan"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_white_border"
                    android:backgroundTint="@color/pink_dropdown_bg"
                    android:entries="@array/list_bulan"
                    android:minWidth="80dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tahun : "
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginEnd="5dp"/>

                <Spinner
                    android:layout_width="98dp"
                    android:id="@+id/spinner_tahun"
                    android:layout_height="25dp"
                    android:background="@drawable/bg_white_border"
                    android:backgroundTint="@color/pink_dropdown_bg"
                    android:entries="@array/list_tahun"
                    android:minWidth="80dp" />
            </LinearLayout>

            <!-- JUDUL PINK -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="15dp"
                app:cardBackgroundColor="@color/pink_title_box"
                app:cardElevation="0dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="15dp"
                    android:text="Presentase Pengeluaran Berdasarkan\nKategori"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>
            <!-- LETAKKAN INI DI POSISI YANG SAMA -->
            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pieChart"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_margin="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <!-- LEGEND (KETERANGAN) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:layout_marginBottom="20dp">

                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="5dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <View android:layout_width="15dp" android:layout_height="15dp" android:background="@color/chart_pink" android:layout_marginEnd="15dp"/>
                    <TextView android:layout_width="100dp" android:text="Makanan" android:textColor="@color/black" android:layout_height="wrap_content"/>
                    <TextView android:text=":  Rp.680.000" android:id="@+id/tv_legend_makanan" android:fontFamily="monospace" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="5dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <View android:layout_width="15dp" android:layout_height="15dp" android:background="@android:color/holo_orange_dark" android:layout_marginEnd="15dp"/>
                    <TextView android:layout_width="100dp" android:text="Transportasi" android:textColor="@color/black" android:layout_height="wrap_content"/>
                    <TextView android:text=":  Rp.255.000" android:id="@+id/tv_legend_transport" android:fontFamily="monospace" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="5dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <View android:layout_width="15dp" android:layout_height="15dp" android:background="@color/chart_yellow" android:layout_marginEnd="15dp"/>
                    <TextView android:layout_width="100dp" android:text="Belanja" android:textColor="@color/black" android:layout_height="wrap_content"/>
                    <TextView android:text=":  Rp.425.000" android:id="@+id/tv_legend_belanja" android:fontFamily="monospace" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="5dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <View android:layout_width="15dp" android:layout_height="15dp" android:background="@color/chart_green" android:layout_marginEnd="15dp"/>
                    <TextView android:layout_width="100dp" android:text="Hiburan" android:textColor="@color/black" android:layout_height="wrap_content"/>
                    <TextView android:text=":  Rp.170.000" android:id="@+id/tv_legend_hiburan" android:fontFamily="monospace" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="5dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <View android:layout_width="15dp" android:layout_height="15dp" android:background="@color/chart_blue" android:layout_marginEnd="15dp"/>
                    <TextView android:layout_width="100dp" android:text="Dana Darurat" android:textColor="@color/black" android:layout_height="wrap_content"/>
                    <TextView android:text=":  Rp.85.000" android:id="@+id/tv_legend_darurat" android:fontFamily="monospace" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- KOTAK INFO BAWAH -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="30dp"
                app:cardBackgroundColor="@color/red_soft_box"
                app:cardElevation="0dp"
                android:layout_marginBottom="15dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/tv_pengeluaran_terbesar"
                    android:text="Pengeluaran Terbesar  :  Makanan (Rp.680.000)"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="15dp"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textAlignment="center"
                    android:textColor="@color/black"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="30dp"
                app:cardBackgroundColor="@color/green_soft_box"
                app:cardElevation="0dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/tv_pengeluaran_terkecil"
                    android:text="Pengeluaran Terkecil  :  Hiburan (Rp.85.000)"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="15dp"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textAlignment="center"
                    android:textColor="@color/black"/>
            </androidx.cardview.widget.CardView>

            <Space android:layout_width="match_parent" android:layout_height="100dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- 3. NAVIGATION BAR (FIXED) -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nav_bottom_bg"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Home -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"/>
        </LinearLayout>

        <!-- Daily Budget -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_list"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Budget"
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"/>
        </LinearLayout>

        <!-- Graphic (AKTIF) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_chart"
                app:tint="@color/nav_active"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Graphic"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nav_active"/>
        </LinearLayout>

        <!-- History -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_history"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>