<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="@color/bg_cream">

    <!-- 1. HEADER (FIXED) -->
    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="15dp"
        android:paddingBottom="5dp"
        android:background="@color/bg_cream"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Logo -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="50dp"
                android:layout_marginStart="-10dp">
                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="45dp"
                    android:src="@drawable/logo"
                    android:scaleType="centerCrop"
                    android:layout_gravity="center_vertical|start" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home Page"
                android:textStyle="bold"
                android:textColor="@color/text_orange"
                android:textSize="17sp"
                android:layout_marginTop="-5dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:id="@+id/bell_icon"
                android:src="@android:drawable/ic_popup_reminder"
                app:tint="#FDD835"
                android:layout_marginEnd="15dp"/>
            <TextView
                android:id="@+id/bell_badge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:text="1"
                android:textSize="10sp"
                android:textColor="@android:color/white"
                android:background="@drawable/badge_red"
                android:gravity="center"
                android:layout_alignTop="@+id/bell_icon"
                android:layout_alignEnd="@+id/bell_icon"
                android:layout_marginTop="-8dp"
                android:layout_marginEnd="-8dp"
                android:visibility="gone"/> <!-- Sembunyikan jika tidak ada notifikasi -->

            <!-- IKON PROFIL BARU -->
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/text_grey"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. AREA KONTEN -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/header_layout"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp"
            android:paddingTop="15dp">

            <!-- BAGIAN KARTU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <!-- Saldo & Pemasukan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="15dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="30dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@color/warna_saldo_utama"
                        android:layout_marginEnd="15dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Saldo bulan ini:"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:textSize="15sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:id="@+id/tv_saldo_bulan_ini"
                                android:layout_height="wrap_content"
                                android:text="Rp. 0"
                                android:textStyle="bold"
                                android:textSize="22sp"
                                android:textColor="@color/black"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="10dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:id="@+id/tv_tanggal_saldo"
                                android:layout_height="wrap_content"
                                android:text="Belum ada data"
                                android:textSize="10sp"
                                android:textColor="#90000000"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        app:cardCornerRadius="30dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@color/warna_tombol">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+"
                                android:id="@+id/btn_add_pemasukan"
                                android:textSize="36sp"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                android:layout_marginTop="-5dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pemasukan"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_marginTop="0dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?android:attr/selectableItemBackground"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Dana Darurat & Pengeluaran -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="30dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/warna_dana_darurat"
                        android:layout_marginEnd="15dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:paddingStart="20dp"
                            android:gravity="center_vertical">
<!--                            <TextView-->
<!--                                android:layout_width="wrap_content"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:text="Dana Darurat:"-->
<!--                                android:textColor="#FF8A80"-->
<!--                                android:textStyle="bold"-->
<!--                                android:textSize="15sp"/>-->
                            <TextView
                                android:layout_width="wrap_content"
                                android:id="@+id/tv_dana_darurat"
                                android:layout_height="wrap_content"
                                android:text="Rp. 0"
                                android:textColor="#FF8A80"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="90dp"
                        android:id="@+id/btn_add_pengeluaran"
                        android:layout_height="90dp"
                        app:cardCornerRadius="30dp"
                        app:cardElevation="4dp"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/warna_tombol">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@android:drawable/stat_sys_warning"
                                app:tint="@color/white"
                                android:layout_marginBottom="2dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pengeluaran"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

            </LinearLayout>

            <!-- SECTION 1: BUDGETING -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="25dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/warna_header"
                app:cardElevation="0dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Budgeting Hari ini"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="20dp"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/black"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="30dp"
                android:paddingTop="10dp">

                <!-- Hari ke X dari 30 -->
                <TextView
                    android:id="@+id/tv_hari_ke"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hari ke 12 dari 30 hari"
                    android:layout_marginBottom="12dp"
                    android:textSize="14sp"
                    android:textColor="@color/black"/>

                <!-- Budget -->
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                    <View android:layout_width="8dp" android:layout_height="8dp" android:background="@android:drawable/radiobutton_off_background" android:backgroundTint="@color/text_grey" android:layout_marginEnd="10dp"/>
                    <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Budget" android:textColor="@color/text_grey"/>
                    <TextView
                        android:id="@+id/tv_budget_harian"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp. 0"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="@color/black"/>
                </LinearLayout>

                <!-- Terpakai -->
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                    <View android:layout_width="8dp" android:layout_height="8dp" android:background="@android:drawable/radiobutton_off_background" android:backgroundTint="@color/text_grey" android:layout_marginEnd="10dp"/>
                    <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Terpakai" android:textColor="@color/text_grey"/>
                    <TextView
                        android:id="@+id/tv_terpakai"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp. 0"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="@color/black"/>
                </LinearLayout>

                <!-- Sisa -->
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:gravity="center_vertical">
                    <View android:layout_width="8dp" android:layout_height="8dp" android:background="@android:drawable/radiobutton_off_background" android:backgroundTint="@color/text_grey" android:layout_marginEnd="10dp"/>
                    <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Sisa" android:textColor="@color/text_grey"/>
                    <TextView
                        android:id="@+id/tv_sisa_budget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp. 0"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="@color/black"/>
                </LinearLayout>
            </LinearLayout>

            <!-- SECTION 2: RINCIAN -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/warna_header"
                app:cardElevation="0dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rincian Pengeluaran Hari ini"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="20dp"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/black"/>
            </androidx.cardview.widget.CardView>

            <!-- List Item 1 -->
            <!-- List Item 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="15dp">
                <androidx.cardview.widget.CardView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="15dp"
                    app:cardBackgroundColor="@color/icon_makanan"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_menu_rotate"
                        app:tint="@color/white"/>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Makanan"
                    android:layout_marginStart="15dp"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tv_kategori_makanan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp. 0"
                    android:fontFamily="monospace"
                    android:textColor="@color/black"/>
            </LinearLayout>

            <!-- List Item 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="15dp">
                <androidx.cardview.widget.CardView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="15dp"
                    app:cardBackgroundColor="@color/icon_transport"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_menu_directions"
                        app:tint="#2E7D32"/>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Transportasi"
                    android:layout_marginStart="15dp"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tv_kategori_transportasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp. 0"
                    android:fontFamily="monospace"
                    android:textColor="@color/black"/>
            </LinearLayout>

            <!-- List Item 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="15dp">
                <androidx.cardview.widget.CardView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="15dp"
                    app:cardBackgroundColor="@color/icon_belanja"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        app:tint="#01579B"/>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Belanja"
                    android:layout_marginStart="15dp"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tv_kategori_belanja"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp. 0"
                    android:fontFamily="monospace"
                    android:textColor="@color/black"/>
            </LinearLayout>

            <!-- List Item 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="15dp">
                <androidx.cardview.widget.CardView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="15dp"
                    app:cardBackgroundColor="@color/icon_hiburan"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="#827717"/>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hiburan"
                    android:layout_marginStart="15dp"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tv_kategori_hiburan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp. 0"
                    android:fontFamily="monospace"
                    android:textColor="@color/black"/>
            </LinearLayout>

            <Space android:layout_width="match_parent" android:layout_height="100dp" />
        </LinearLayout>
    </ScrollView>

    <!-- 3. NAVIGATION BAR (FIXED) -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nav_bottom_bg"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/nav_active"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nav_active"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:id="@+id/nav_daily_budget"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_list"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Budget"
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:id="@+id/nav_graphic"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_chart"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Graphic"
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:id="@+id/nav_categories"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_history"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categories"
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>