<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="@color/bg_cream">

    <!-- 1. HEADER KHUSUS (PINK) -->
    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/input_header_bg"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Gunakan hanya SATU ImageView untuk tombol kembali -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- GANTI: gunakan ID yang sama di sini, jangan buat baru -->
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/black"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:fontFamily="serif"/>
        </LinearLayout>

        <!-- Logo di Kanan -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="45dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">
            <ImageView
                android:layout_width="110dp"
                android:layout_height="45dp"
                android:src="@drawable/logo"
                android:scaleType="centerCrop"
                android:layout_gravity="right"/>
        </FrameLayout>
    </RelativeLayout>

    <!-- 2. KONTEN INPUT (Tengah) -->
    <!-- Tidak pakai ScrollView karena konten sedikit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="30dp"
        android:paddingTop="30dp"
        app:layout_constraintTop_toBottomOf="@+id/header_layout"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation">

        <!-- Judul Kotak -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INPUT PEMASUKAN"
            android:background="@drawable/bg_input_title"
            android:paddingVertical="8dp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:layout_marginBottom="40dp"/>

        <!-- Formulir Input (TableLayout agar Rapi) -->
        <!-- Formulir Input -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="2">

            <!-- Baris 1: Jumlah Pemasukan -->
            <TableRow android:layout_marginBottom="20dp">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/shape_circle_grey"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="10dp"
                    app:tint="@color/text_grey"/>

                <TextView
                    android:text="Jumlah Pemasukan"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_marginEnd="10dp"/>

                <EditText
                    android:id="@+id/edit_jumlah_pemasukan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Rp. 0"
                    android:inputType="numberDecimal"
                    android:textSize="14sp"
                    android:background="@drawable/bg_input_title"
                    android:padding="8dp"/>
            </TableRow>

            <!-- Baris 2: Dana Darurat -->
            <TableRow android:layout_marginBottom="20dp">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/shape_circle_grey"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="10dp"
                    app:tint="@color/text_grey"/>

                <TextView
                    android:text="Alokasi Dana Darurat"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_marginEnd="10dp"/>

                <EditText
                    android:id="@+id/edit_dana_darurat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Rp. 0"
                    android:inputType="numberDecimal"
                    android:textSize="14sp"
                    android:background="@drawable/bg_input_title"
                    android:padding="8dp"/>
            </TableRow>

            <!-- Baris 3: Tanggal Input -->
            <TableRow android:layout_marginBottom="20dp">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/shape_circle_grey"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="10dp"
                    app:tint="@color/text_grey"/>

                <TextView
                    android:text="Tanggal Input"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/tv_tanggal_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pilih Tanggal"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:padding="8dp"/>
            </TableRow>
        </TableLayout>

        <!-- Spacer agar tombol turun ke bawah -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Tombol Simpan -->
        <TextView
            android:id="@+id/btn_simpan_pemasukan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Pemasukan"
            android:background="@drawable/bg_btn_save"
            android:textAlignment="center"
            android:paddingVertical="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/btn_save_text"
            android:layout_marginBottom="30dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- 3. NAVIGATION BAR (FIXED) -->
    <!-- Tidak ada menu yang aktif karena ini sub-halaman -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nav_bottom_bg"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Home -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/nav_active"/> <!-- Aktif karena ini turunan Home -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nav_active"/>
        </LinearLayout>

        <!-- Daily Budget -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_list"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Budget"
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"/>
        </LinearLayout>

        <!-- Graphic -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_chart"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Graphic"
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"/>
        </LinearLayout>

        <!-- History -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_history"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>