<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="@color/bg_cream">

    <!-- 1. HEADER (FIXED) -->
    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/input_header_bg"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tombol Kembali & Teks Home -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/black"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:fontFamily="serif"/>
        </LinearLayout>

        <!-- Logo -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="45dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">
            <ImageView
                android:layout_width="110dp"
                android:layout_height="45dp"
                android:src="@drawable/logo"
                android:scaleType="centerCrop"
                android:layout_gravity="right"/>
        </FrameLayout>
    </RelativeLayout>

    <!-- 2. KONTEN INPUT (TENGAH) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="30dp"
        android:paddingTop="30dp"
        app:layout_constraintTop_toBottomOf="@+id/header_layout"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation">

        <!-- Judul Kotak -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INPUT PENGELUARAN"
            android:background="@drawable/bg_input_title"
            android:paddingVertical="8dp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:layout_marginBottom="30dp"/>

        <!-- Formulir Input -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="2">

        <!-- Baris 1: Jumlah Pengeluaran -->
        <TableRow android:layout_marginBottom="20dp">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/shape_circle_grey"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="10dp"
                app:tint="@color/text_grey"/>
            <TextView
                android:text="Jumlah Pengeluaran"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:layout_marginEnd="10dp"/>
            <EditText
                android:id="@+id/edit_jumlah_pengeluaran"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Rp. 0"
                android:inputType="numberDecimal"
                android:textSize="13sp"
                android:background="@drawable/bg_input_title"
                android:padding="6dp"/>
        </TableRow>

        <!-- Baris 2: Deskripsi -->
        <TableRow android:layout_marginBottom="20dp">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/shape_circle_grey"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="10dp"
                app:tint="@color/text_grey"/>
            <TextView
                android:text="Deskripsi"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:layout_marginEnd="10dp"/>
            <EditText
                android:id="@+id/edit_deskripsi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contoh: Makan siang"
                android:textSize="13sp"
                android:background="@drawable/bg_input_title"
                android:padding="6dp"/>
        </TableRow>

        <!-- Baris 3: Kategori -->
        <TableRow android:layout_marginBottom="20dp">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/shape_circle_grey"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="10dp"
                app:tint="@color/text_grey"/>
            <TextView
                android:text="Kategori"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:layout_marginEnd="10dp"/>
            <Spinner
                android:id="@+id/spinner_kategori"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:entries="@array/list_kategori"
                android:background="@drawable/bg_white_border"
                android:backgroundTint="@color/bg_dropdown_pink"/>
        </TableRow>

        <!-- Baris 4: Tanggal -->
        <TableRow android:layout_marginBottom="30dp">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/shape_circle_grey"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="10dp"
                app:tint="@color/text_grey"/>
            <TextView
                android:text="Tanggal Pengeluaran"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:id="@+id/tv_tanggal_pengeluaran"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih tanggal"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"/>
        </TableRow>
        </TableLayout>



        <!-- BAGIAN SCAN BUKTI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <!-- LABEL KETERANGAN SCAN (BUKAN TOMBOL) -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SCAN BUKTI TRANSAKSI"
                android:background="@drawable/bg_scan_label"
                android:paddingVertical="12dp"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:layout_marginEnd="15dp"/>

            <!-- TOMBOL IKON SCAN (INI YANG DIKLIK) -->
            <LinearLayout
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@drawable/bg_scan_icon"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_scan"
                    app:tint="@color/black"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Tombol Simpan -->
        <TextView
            android:id="@+id/btn_simpan_pengeluaran"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Pengeluaran"
            android:background="@drawable/bg_save_button"
            android:textAlignment="center"
            android:paddingVertical="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_green_dark"
            android:layout_marginBottom="30dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <!-- 3. NAVIGATION BAR (FIXED) -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nav_bottom_bg"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Home -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/nav_active"/> <!-- Aktif -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nav_active"/>
        </LinearLayout>

        <!-- Daily Budget -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_list"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Budget"
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"/>
        </LinearLayout>

        <!-- Graphic -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_chart"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Graphic"
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"/>
        </LinearLayout>

        <!-- History -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_history"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>