<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingBottom="15dp">

    <!-- Card View Utama -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_grey"
        app:strokeWidth="2dp"
        android:layout_marginEnd="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header: Hari ke X -->
            <TextView
                android:id="@+id/tv_hari_tanggal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/daily_item_header"
                android:text="Hari ke 1 : 1 Oktober 2025"
                android:paddingHorizontal="15dp"
                android:paddingVertical="8dp"
                android:textSize="11sp"
                android:textColor="@color/black"/>

            <!-- Isi: Budget & Real -->
            <TextView
                android:id="@+id/tv_budget_real"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:text="Budget : Rp.50.000\nReal   : Rp.50.000"
                android:fontFamily="monospace"
                android:paddingHorizontal="15dp"
                android:paddingVertical="10dp"
                android:textSize="11sp"
                android:textColor="@color/black"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tombol Cross Merah -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_cross"
        android:layout_width="45dp"
        android:layout_height="45dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="@color/btn_cross_red"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:layout_marginEnd="8dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:src="@android:drawable/ic_delete"
            app:tint="@color/white"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tombol Check Hijau -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_check"
        android:layout_width="45dp"
        android:layout_height="45dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="@color/btn_check_green"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:src="@android:drawable/checkbox_on_background"
            app:tint="@color/white"/>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>